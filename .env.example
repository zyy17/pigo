# Copy to .env and fill in. pigo reads .env from the current directory
# and leaves variables that are already set untouched.

# Required.
PIGO_API_KEY=

# OpenAI-compatible API root. Do not append /chat/completions.
PIGO_BASE_URL=https://api.openai.com/v1

# Any model name that endpoint accepts.
PIGO_MODEL=gpt-4o-mini
