# Copy to .env and fill in. pigo reads .env from the current directory.
# Precedence: flags > environment > .env > ~/.pigo/config.yaml and ./pigo.yaml > defaults.
# Blank values are ignored. Variables already set in the environment are left untouched.

# Chat backend. openai means any OpenAI-compatible chat-completions endpoint.
# It is the only provider pigo implements.
PIGO_PROVIDER=openai

# Required when PIGO_PROVIDER=openai.
OPENAI_API_KEY=

# API root for that provider. Do not append /chat/completions.
OPENAI_BASE_URL=https://api.openai.com/v1

# Any model name that endpoint accepts.
OPENAI_MODEL=gpt-4o-mini
